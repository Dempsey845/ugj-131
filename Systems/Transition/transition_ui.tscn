[sub_resource type="Shader" id="Shader_transition"]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 0.0;

uniform vec4 background_colour : source_color = vec4(0.055, 0.075, 0.12, 1.0);
uniform vec4 stripe_colour_1 : source_color = vec4(0.99, 0.35, 0.28, 1.0);
uniform vec4 stripe_colour_2 : source_color = vec4(1.0, 0.79, 0.24, 1.0);
uniform vec4 stripe_colour_3 : source_color = vec4(0.22, 0.78, 0.72, 1.0);

uniform float edge_softness : hint_range(0.001, 0.1) = 0.012;
uniform float wave_amount : hint_range(0.0, 0.2) = 0.035;
uniform float stripe_size : hint_range(0.02, 0.5) = 0.12;

void fragment() {
	vec2 uv = UV;

	float wave =
		sin(uv.y * 18.0 + TIME * 5.0) * wave_amount
		+ sin(uv.y * 37.0 - TIME * 3.0) * wave_amount * 0.35;

	float edge = progress * 1.55 - 0.25;
	float coverage = 1.0 - smoothstep(
		edge - edge_softness,
		edge + edge_softness,
		uv.x + wave
	);

	float stripe_coordinate = uv.x + uv.y * 0.42 - TIME * 0.12;
	float stripe = fract(stripe_coordinate / stripe_size);

	vec4 colour = background_colour;

	if (stripe < 0.12) {
		colour = stripe_colour_1;
	} else if (stripe < 0.20) {
		colour = stripe_colour_2;
	} else if (stripe < 0.27) {
		colour = stripe_colour_3;
	}

	float leading_edge = 1.0 - smoothstep(
		0.0,
		0.055,
		abs((uv.x + wave) - edge)
	);

	colour.rgb += leading_edge * vec3(0.32, 0.38, 0.42);
	colour.a *= coverage;

	COLOR = colour;
}"

