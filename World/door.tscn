[ext_resource type="Script" uid="uid://b5wg07rcnnbd6" path="res://World/door.gd" id="2_3wo5c"]

[sub_resource type="Shader" id="Shader_xb3ck"]
code = "shader_type spatial;

render_mode blend_mix,
	depth_prepass_alpha,
	cull_disabled,
	diffuse_burley,
	specular_schlick_ggx;

uniform vec4 glass_tint : source_color = vec4(
	0.72,
	0.9,
	1.0,
	1.0
);

uniform float transparency : hint_range(0.0, 1.0) = 0.18;
uniform float roughness : hint_range(0.0, 1.0) = 0.08;
uniform float specular : hint_range(0.0, 1.0) = 1.0;

uniform float refraction_strength :
	hint_range(0.0, 0.05, 0.001) = 0.008;

uniform float fresnel_strength :
	hint_range(0.0, 1.0) = 0.35;

uniform float fresnel_power :
	hint_range(0.5, 8.0) = 3.0;

uniform vec4 edge_colour : source_color = vec4(
	0.75,
	0.95,
	1.0,
	1.0
);

uniform sampler2D screen_texture :
	hint_screen_texture,
	filter_linear_mipmap;

void fragment() {
	vec3 glass_normal = NORMAL;

	if (!FRONT_FACING) {
		glass_normal *= -1.0;
	}

	float view_dot = clamp(
		dot(normalize(glass_normal), normalize(VIEW)),
		0.0,
		1.0
	);

	float fresnel = pow(
		1.0 - view_dot,
		fresnel_power
	);

	vec2 refraction_offset =
		glass_normal.xy *
		refraction_strength *
		(1.0 - view_dot * 0.5);

	vec3 refracted_scene = textureLod(
		screen_texture,
		SCREEN_UV + refraction_offset,
		roughness * 4.0
	).rgb;

	vec3 edge_reflection = edge_colour.rgb * fresnel;

	ALBEDO = mix(
		refracted_scene * glass_tint.rgb,
		edge_reflection,
		fresnel * fresnel_strength
	);

	METALLIC = 0.0;
	SPECULAR = specular;
	ROUGHNESS = roughness;

	ALPHA = clamp(
		transparency + fresnel * fresnel_strength,
		0.0,
		0.85
	);
}"

